rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // uid ↔ journalId 매핑 — 본인만 읽기/쓰기
    match /userJournals/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 저널 데이터 — 로그인한 uid의 journalId와 일치하는 경우만 접근 허용
    match /journals/{journalId}/{document=**} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/userJournals/$(request.auth.uid)).data.journalId == journalId;
    }
  }
}
